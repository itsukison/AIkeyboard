            "value" : "Create an account to unlock AI rewriting and to save and sync your custom buttons."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "创建账号后即可使用 AI 改写，并保存和同步自定义按钮。"
          }
        }
      }
    },
    "アカウントを作成すると、AI書き直しやカスタムプロンプトの保存・同期が使えます。" : {
