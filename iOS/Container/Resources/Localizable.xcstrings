    "アカウント、保存したプロンプト、変換履歴を完全に削除します。この操作は取り消せません。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account, saved prompts, and conversion history will be permanently deleted. This action cannot be undone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将永久删除你的账号、已保存的提示词和转换历史。此操作无法撤销。"
          }
        }
      }
    },
